<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/ra_achievements_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ra_achievements_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/switch_text_primary" />

    <TextView
        android:id="@+id/ra_achievements_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="@color/switch_text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ra_achievements_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/ra_achievements_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/ra_achievements_empty"
        android:textColor="@color/switch_text_secondary"
        android:visibility="gone" />
</LinearLayout>
