<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- For secondary display: placeholder that shows "Bottom Screen" label.
         The actual GLRetroView for DS bottom screen is rendered via Presentation
         or by the core's dual-screen layout option (melonds_screen_layout1 / desmume_screens_layout).
         This layout is inflated by SecondaryDisplayActivity on external displays. -->
    <TextView
        android:id="@+id/secondary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="DS Bottom Screen"
        android:textColor="#88FFFFFF"
        android:textSize="18sp" />

</FrameLayout>
