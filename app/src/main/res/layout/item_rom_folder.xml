<?xml version="1.0" encoding="utf-8"?>
<!-- ROM folder item in settings: folder path + delete button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:background="@drawable/bg_app_item"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/rom_folder_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/switch_text_primary"
        android:textSize="@dimen/switch_suffix_text"
        android:maxLines="1"
        android:ellipsize="middle"
        android:singleLine="true"
        tools:text="/storage/emulated/0/ROMs" />

    <ImageButton
        android:id="@+id/rom_folder_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_button"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@color/switch_text_secondary"
        android:contentDescription="@string/dialog_cancel"
        android:scaleType="centerInside" />
</LinearLayout>
