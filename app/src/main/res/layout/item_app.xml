<?xml version="1.0" encoding="utf-8"?>
<!-- Single app row: icon + name + package. Used inside category sections in AppsActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_app_item"
    android:layout_marginBottom="4dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- App icon (loaded via PackageManager). -->
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        tools:src="@android:drawable/sym_def_app_icon" />

    <!-- Text block. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/switch_text_primary"
            android:textSize="@dimen/switch_row_text"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Chrome" />

        <TextView
            android:id="@+id/app_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/switch_text_secondary"
            android:textSize="@dimen/switch_hint_text"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            tools:text="com.android.chrome" />
    </LinearLayout>

    <!-- Launch arrow indicator. -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/switch_text_secondary"
        android:contentDescription="@null" />
</LinearLayout>
