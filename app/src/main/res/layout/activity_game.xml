<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- GLRetroView is added programmatically here -->
    <FrameLayout
        android:id="@+id/retro_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Touch control overlay (on-screen d-pad, buttons, shoulders) -->
    <br.com.redclaw.swt.game.GameTouchOverlay
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- In-game menu overlay -->
    <LinearLayout
        android:id="@+id/menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/menu_resume"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Resume" />

        <Button
            android:id="@+id/menu_save_state"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Save State" />

        <Button
            android:id="@+id/menu_load_state"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Load State" />

        <Button
            android:id="@+id/menu_reset"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Reset" />

        <Button
            android:id="@+id/menu_restart"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Restart Game" />

        <Button
            android:id="@+id/menu_secondary_display"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="DS Bottom Screen"
            android:visibility="gone" />

        <Button
            android:id="@+id/menu_quit"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:text="Quit"
            android:textColor="#FF4444" />

    </LinearLayout>

</FrameLayout>
