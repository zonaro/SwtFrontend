<?xml version="1.0" encoding="utf-8"?>
<!-- Switch-style library card: icon + label for the 4-tile grid below the home row.
     Focusable; shows a round accent focus border when D-pad-selected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_library_card"
    android:elevation="@dimen/card_elevation"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:minHeight="100dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/library_card_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/library_card_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/switch_text_primary"
            android:textSize="@dimen/switch_row_text"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Round accent focus border, shown only when focused. -->
    <View
        android:id="@+id/library_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/switch_focus_border_round"
        android:visibility="gone" />

</FrameLayout>
