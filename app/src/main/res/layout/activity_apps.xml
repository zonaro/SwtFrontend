<?xml version="1.0" encoding="utf-8"?>
<!-- Apps screen: list of installed Android apps grouped by category, Switch-style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/switch_bg">

    <!-- Header: back button + icon + title. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/switch_screen_margin">

        <ImageButton
            android:id="@+id/apps_back"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_icon_button"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/switch_text_primary"
            android:contentDescription="@string/dialog_cancel"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/apps_header_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_dock_apps"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@string/apps_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/apps_title"
            android:textColor="@color/switch_text_primary"
            android:textSize="@dimen/switch_title_text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thin separator. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/switch_text_secondary" />

    <!-- Search / filter bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/switch_screen_margin"
        android:layout_marginEnd="@dimen/switch_screen_margin"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/apps_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="@string/grid_search_hint"
            android:textColor="@color/switch_text_primary"
            android:textColorHint="@color/switch_text_secondary"
            android:textSize="@dimen/switch_row_text"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:singleLine="true"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawableTint="@color/switch_text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/switch_grid_padding"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_app" />

        <TextView
            android:id="@+id/apps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            android:text="@string/apps_empty"
            android:textColor="@color/switch_text_secondary"
            android:textSize="16sp" />
    </FrameLayout>
</LinearLayout>
