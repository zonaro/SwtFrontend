<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="br.com.redclaw.swt.permission.BIND_MODULE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="br.com.redclaw.swt.module.BIND" />
        </intent>
    </queries>

    <application
        android:name=".SwtApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Swt"
        android:largeHeap="true">

        <activity
            android:name=".views.LibraryActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity kept as redirect for backward compatibility. -->
        <activity
            android:name=".views.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".browser.InternalSimpleBrowser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".views.GameGridActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".views.AppsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".views.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".game.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".game.SecondaryDisplayActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".ra.ui.RaProfileActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".ra.ui.AchievementsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".capture.GalleryActivity"
            android:exported="true"
            android:permission="br.com.redclaw.swt.permission.BIND_MODULE"
            android:theme="@style/Theme.Swt">
            <intent-filter>
                <action android:name="br.com.redclaw.swt.capture.GALLERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.CaptureViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".capture.CaptureProjectionActivity"
            android:exported="true"
            android:permission="br.com.redclaw.swt.permission.BIND_MODULE"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Swt">
            <intent-filter>
                <action android:name="br.com.redclaw.swt.capture.SCREENSHOT" />
                <action android:name="br.com.redclaw.swt.capture.RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".dashboard.DashboardService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".capture.CaptureProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name=".capture.CaptureFileProvider"
            android:authorities="br.com.redclaw.swt.capture.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_filepaths" />
        </provider>

    </application>

</manifest>