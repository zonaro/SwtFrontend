<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SwtApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Swt"
        android:largeHeap="true">

        <activity
            android:name=".views.LibraryActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity kept as redirect for backward compatibility. -->
        <activity
            android:name=".views.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".browser.InternalSimpleBrowser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".views.GameGridActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".views.AppsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".views.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".game.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".game.SecondaryDisplayActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".ra.ui.RaProfileActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <activity
            android:name=".ra.ui.AchievementsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Swt" />

        <service
            android:name=".dashboard.DashboardService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>